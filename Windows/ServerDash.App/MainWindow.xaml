<Window
    x:Class="ServerDash.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ServerDash">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="16,0">
            <Grid>
                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="ServerDash" />
                <TextBlock
                    x:Name="StatusText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="P1 核心" />
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="主机" />
                    <ListView
                        x:Name="HostList"
                        Grid.Row="1"
                        Margin="0,8,0,8"
                        SelectionChanged="HostList_SelectionChanged" />
                    <StackPanel Grid.Row="2" Spacing="8">
                        <Button x:Name="AddHostButton" Content="添加主机" Click="AddHost_Click" HorizontalAlignment="Stretch" />
                        <Button x:Name="ConnectButton" Content="连接" Click="Connect_Click" HorizontalAlignment="Stretch" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
            <Pivot x:Name="WorkspacePivot" Grid.Column="1">
                <PivotItem Header="监控">
                    <ScrollViewer Padding="16">
                        <TextBlock x:Name="MonitorText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="连接后采集 CPU、内存、负载、磁盘、网络和进程。完整 GPU/Docker 卡片不在本阶段。" />
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="终端">
                    <Grid Padding="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox
                            x:Name="TerminalOutput"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            TextWrapping="Wrap"
                            FontFamily="Consolas"
                            PlaceholderText="基础 SSH 会话（不是完整 VT 仿真）。" />
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TerminalInput" KeyDown="TerminalInput_KeyDown" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="发送" Click="TerminalSend_Click" />
                        </Grid>
                    </Grid>
                </PivotItem>
                <PivotItem Header="SFTP">
                    <Grid Padding="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SftpPath" Text="/" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="列出" Click="SftpList_Click" />
                        </Grid>
                        <ListView x:Name="SftpList" Grid.Row="1" Margin="0,8" />
                        <StackPanel Grid.Row="2" Spacing="8">
                            <TextBox x:Name="SftpLocalPath" PlaceholderText="本地路径" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="下载选中" Click="SftpDownload_Click" />
                                <Button Content="上传本地文件" Click="SftpUpload_Click" />
                            </StackPanel>
                            <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="下载仅在本地目标存在后才算成功。不包含远程编辑或目录同步。" />
                        </StackPanel>
                    </Grid>
                </PivotItem>
            </Pivot>
        </Grid>
    </Grid>
</Window>
